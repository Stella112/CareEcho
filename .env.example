# AssemblyAI — speech-to-text (server-side only, never exposed to the browser)
ASSEMBLYAI_API_KEY=

# OpenAI — structured extraction + evidence-grounded answers (server-side only)
OPENAI_API_KEY=
# Optional override. Defaults to gpt-5.5.
# OPENAI_MODEL=gpt-5.5

# Required for real accounts and cross-device health memory.
# Use the publishable key from Supabase; the anon name is supported for older projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
